# ===================================================================
# .gitignore - SIMKlinik Utama Dr. H. A. Rotinsulu Cianjur
# ===================================================================

# 1. Kredensial Sensitif Google Cloud (SANGAT PENTING: JANGAN DI-PUSH!)
google-credentials.json
*credentials*.json
*.pem
*.key

# 2. Basis Data Lokal SQLite (Data Rekam Medis Pasien)
data/
server/data/
backups/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db

# 3. Dependensi Node.js
node_modules/
server/node_modules/
client/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. Berkas Hasil Kompilasi / Build Artifacts
server/dist/
server/dist-dev/
client/.next/
client/.next-dev/
client/out/
portal/portal-dashboard/.next/
portal/portal-dashboard/.next-dev/
portal/portal-dashboard/out/
portal/identity-service/dist/
dist/
*.tsbuildinfo
# 7. Berkas Unduhan / Ekspor Sementara
#
# PENTING: sebelumnya ada baris "!SUHERIONO (MCU).pdf", "!*.docx", dan "!*.pdf"
# di sini. Tanda "!" membatalkan aturan ignore di atasnya, sehingga berkas hasil
# MCU berisi nama pasien ikut ter-commit dan ter-push ke repositori publik.
# Negasi semacam itu tidak boleh dikembalikan.
*.xlsx
*.pdf
*.docx
*.doc
*.csv
*.rtf

# 5. Berkas Environment Variables
.env
.env*.local
.env.development
.env.production
.env.test

# 6. File Sistem Operasi & Editor
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
.claude/
*.swp
*.swo

# Gambar kop surat dipakai aplikasi, jadi dikecualikan dari aturan umum.
# Hanya tiga berkas ini — jangan menambah pola "!*.jpeg" / "!*.png" karena
# akan membuka semua gambar, termasuk hasil pindai dokumen pasien.
!header-hasil.jpeg
